{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memivy Phase 1",
  "version": "0.1.0",
  "identifier": "com.memivy.phase1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {"label":"main","title":"Memivy · 交互样机 v2","width":1140,"height":790,"minWidth":760,"minHeight":560,"acceptFirstMouse":true},
      {"label":"capture","title":"Memivy · 桌面助手","url":"index.html?window=capture","width":72,"height":76,"visible":false,"focus":false,"transparent":true,"decorations":false,"resizable":false,"alwaysOnTop":true,"skipTaskbar":true,"visibleOnAllWorkspaces":true,"acceptFirstMouse":true}
    ],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"}
