{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memivy",
  "version": "0.1.1",
  "identifier": "com.memivy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memivy",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 28
        },
        "width": 1140,
        "height": 790,
        "minWidth": 760,
        "minHeight": 560,
        "acceptFirstMouse": true,
        "visible": false
      },
      {
        "label": "capture",
        "title": "Memivy",
        "url": "index.html?window=capture",
        "width": 72,
        "height": 76,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/memivy.icns",
      "icons/app-icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "infoPlist": "Info.release.plist",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "infoplist/en.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "infoplist/zh-Hans.lproj/InfoPlist.strings"
      }
    }
  }
}
