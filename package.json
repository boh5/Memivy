{
  "name": "memivy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "dev:app": "npm run build:mcp && tauri dev",
    "dev:prototype": "MEMIVY_PHASE1_PROTOTYPE=1 tauri dev --config src-tauri/tauri.prototype.conf.json",
    "test:ui": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:mcp": "node scripts/prepare-mcp.mjs --debug",
    "build:beta": "node scripts/build-beta.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9",
    "vite": "8.2.2"
  }
}
