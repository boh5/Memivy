{
  "name": "memivy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "node scripts/tauri.mjs",
    "check": "tsc --noEmit",
    "dev:app": "npm run build:mcp && npm run tauri -- dev",
    "test:ui": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:mcp": "node scripts/prepare-mcp.mjs --debug",
    "test:core-assets": "python3 scripts/verify_core_assets.py",
    "i18n:check": "node scripts/check-i18n.mjs",
    "build:release": "node scripts/build-release.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "@tanstack/react-query": "5.102.8",
    "@tauri-apps/api": "^2.11.1",
    "i18next": "26.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "29.1.1",
    "typescript": "^5.9",
    "vite": "8.2.2"
  },
  "license": "MIT",
  "author": "Huang Bo",
  "repository": {
    "type": "git",
    "url": "https://github.com/boh5/memivy.git"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
